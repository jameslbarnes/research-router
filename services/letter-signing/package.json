{
  "name": "letter-signing",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "preview": "node preview.mjs",
    "preview:invitations": "node invitations.preview.mjs",
    "build": "node build.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "test": "node --test app.test.mjs",
    "test:worker": "node build.mjs && node --test worker.test.mjs",
    "check": "node build.mjs && wrangler deploy --dry-run --outdir /private/tmp/letter-worker-build"
  },
  "devDependencies": { "wrangler": "4.143.0" }
}
